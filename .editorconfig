# Mono.TextTemplating — EditorConfig

root = true

[*]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
csharp_indent_labels = one_less_than_current
csharp_using_directive_placement = outside_namespace
csharp_prefer_braces = true
csharp_style_namespace_declarations = block_scoped
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = false
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_properties = when_on_single_line
csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_pattern_matching_over_as_with_null_check = true
csharp_style_inlined_variable_declaration = true

[*.{xml,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Vendored Mono.Options code — suppress all analysis and doc warnings
[src/Mono.TextTemplating.Cli/Options.cs]
generated_code = true
dotnet_diagnostic.CS1591.severity = none

# Test projects — suppress warnings that are intentional in test code
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none       # underscores in BDD-style test method names
dotnet_diagnostic.CA1822.severity = none       # test helpers can be static
dotnet_diagnostic.CA1051.severity = none       # test helper visible fields
dotnet_diagnostic.CA1859.severity = none       # concrete type preference not relevant in tests
dotnet_diagnostic.CA1852.severity = none       # sealed not relevant in tests
dotnet_diagnostic.CA2211.severity = none       # non-constant fields in test fixtures
dotnet_diagnostic.CA1310.severity = none       # StringComparison not critical in tests
dotnet_diagnostic.CS8625.severity = none       # nullable — intentional null in tests
dotnet_diagnostic.CS8604.severity = none       # nullable — intentional null in tests
dotnet_diagnostic.CS8603.severity = none       # nullable — intentional null return in tests
