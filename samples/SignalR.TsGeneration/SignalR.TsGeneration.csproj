<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SignalR.TsGeneration</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mono.TextTemplating\Mono.TextTemplating.csproj" />
    <ProjectReference Include="..\..\src\Mono.TextTemplating.Cli\Mono.TextTemplating.Cli.csproj" />
  </ItemGroup>

  <Target Name="GenerateTsClients" AfterTargets="Build">
    <Exec Command="dotnet run --no-build --project $(MSBuildThisFileDirectory)..\..\src\Mono.TextTemplating.Cli\Mono.TextTemplating.Cli.csproj -c $(Configuration) -- -o $(MSBuildThisFileDirectory)Templates\HubClientGenerator.ts -a TargetAssembly!$(TargetPath) $(MSBuildThisFileDirectory)Templates\HubClientGenerator.tt" />
  </Target>

</Project>
