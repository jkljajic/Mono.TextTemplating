<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SignalR.TsGeneration</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <Import Project="..\..\src\Mono.TextTemplating.Build\build\Mono.TextTemplating.Build.props" />

  <!-- .tt generates .ts, not .cs -->
  <ItemGroup>
    <T4PostBuildTemplate Update="Templates\**\*.tt">
      <LastGenOutput>%(RelativeDir)%(Filename).generated.ts</LastGenOutput>
    </T4PostBuildTemplate>
  </ItemGroup>

  <Import Project="..\..\src\Mono.TextTemplating.Build\build\Mono.TextTemplating.Build.targets" />

</Project>
