<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SignalR.TsGeneration</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- T4 post-build: .tt → .ts next to the template, discovered by .props -->
  <ItemGroup>
    <T4PostBuildTemplate Update="Templates\**\*.tt">
      <LastGenOutput>%(RootDir)%(Directory)%(Filename).ts</LastGenOutput>
    </T4PostBuildTemplate>
  </ItemGroup>

  <Import Project="..\..\src\Mono.TextTemplating.Build\build\Mono.TextTemplating.Build.props" />
  <Import Project="..\..\src\Mono.TextTemplating.Build\build\Mono.TextTemplating.Build.targets" />

</Project>
