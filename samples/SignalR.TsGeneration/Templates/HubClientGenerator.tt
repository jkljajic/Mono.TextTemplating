<#@ template language="C#" hostspecific="true" debug="true" #>
<#@ output extension=".ts" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Reflection" #>
<#@ import namespace="System.Threading.Tasks" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="T4Studio" #>
<#
    var hubs = this.Host.FindSubclassesOf (typeof (Microsoft.AspNetCore.SignalR.Hub));

    if (hubs.Count == 0) {
        Write ("// No SignalR Hub types found. Pass -r assembly.dll\n");
    }
    else {
#>
// ═══════════════════════════════════════════════════
// Auto-generated SignalR TypeScript clients
// Hubs: <#= string.Join (", ", hubs.Select (h => h.Name)) #>
// Generated by T4 Studio
// DO NOT EDIT - regenerated during dotnet build
// ═══════════════════════════════════════════════════

import * as signalR from "@microsoft/signalr";
<#
    foreach (var hubType in hubs.OrderBy (t => t.Name)) {
        var name = hubType.Name;
        var methods = this.Host.GetTaskMethods (hubType);
#>

//
// Client for <#= name #> (<#= methods.Count #> methods)
//
export class <#= name #>Client {
    private connection: signalR.HubConnection;

    constructor (connection: signalR.HubConnection) {
        this.connection = connection;
    }
<#
        foreach (var m in methods) {
            var ps = m.GetParameters ();
            var psStr = string.Join (", ", ps.Select (p => p.Name + ": " + TsType (p.ParameterType)));
            var invokeArgs = ps.Length > 0
                ? string.Join (", ", ps.Select (p => "\"" + p.Name + "\", " + p.Name))
                : "";
            var jsdoc = ps.Length > 0
                ? " " + string.Join (" ", ps.Select (p => "@param " + p.Name + " {" + TsType (p.ParameterType) + "}"))
                : "";
#>

    /**<#= jsdoc #> */
    async <#= Camel (m.Name) #>(<#= psStr #>): <#= GetRet (m) #> {
<# if (ps.Length > 0) { #>
        return this.connection.invoke ("<#= m.Name #>", <#= invokeArgs #>);
<# } else { #>
        return this.connection.invoke ("<#= m.Name #>");
<# } #>
    }
<#
        }
#>
}

//
// Connection factory
//
export async function connect<#= name #>(url: string): Promise<<#= name #>Client> {
    const connection = new signalR.HubConnectionBuilder ()
        .withUrl (url)
        .withAutomaticReconnect ()
        .build ();
    await connection.start ();
    return new <#= name #>Client (connection);
}
<#
    }
    }
#>
<#+
    string TsType (Type t) {
        if (t == typeof (string))  return "string";
        if (t == typeof (bool))    return "boolean";
        if (t == typeof (int) || t == typeof (long) || t == typeof (short) || t == typeof (byte))  return "number";
        if (t == typeof (float) || t == typeof (double) || t == typeof (decimal)) return "number";
        if (t == typeof (void))    return "void";
        if (t == typeof (DateTime) || t == typeof (DateTimeOffset) || t == typeof (Guid)) return "string";
        if (t.IsEnum)              return "number";
        if (t.IsArray)             return TsType (t.GetElementType () ?? typeof (object)) + "[]";
        if (t.IsGenericType) {
            var gd = t.GetGenericTypeDefinition ();
            var ga = t.GetGenericArguments ();
            if (gd == typeof (Nullable<>))    return TsType (ga[0]) + " | null";
            if (gd == typeof (Task<>))        return "Promise<" + TsType (ga[0]) + ">";
            if (gd == typeof (List<>) || gd == typeof (IList<>) || gd == typeof (IEnumerable<>)) return TsType (ga[0]) + "[]";
            if (gd == typeof (Dictionary<,>)) return "Record<" + TsType (ga[0]) + ", " + TsType (ga[1]) + ">";
        }
        return "any";
    }
    string GetRet (MethodInfo m) {
        var r = m.ReturnType;
        if (r.IsGenericType && r.GetGenericTypeDefinition () == typeof (Task<>))
            return "Promise<" + TsType (r.GetGenericArguments ()[0]) + ">";
        return "Promise<void>";
    }
    string Camel (string s) => string.IsNullOrEmpty (s) ? "" : char.ToLowerInvariant (s[0]) + s.Substring (1);
#>
