<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mono.TextTemplating.Build</RootNamespace>
    <AssemblyName>Mono.TextTemplating.Build</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Title>Mono.TextTemplating.Build</Title>
    <Description>MSBuild integration for Mono.TextTemplating — transforms .tt files during dotnet build.</Description>
    <Company>The Mono Project</Company>
    <Product>Mono.TextTemplating</Product>
    <Copyright>MIT</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>t4;texttemplating;code-generation;template;tt;msbuild;build</PackageTags>

    <VersionPrefix>3.0.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <IsPackable>true</IsPackable>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>

    <!-- Bundle dependencies for MSBuild task loading -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.6.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mono.TextTemplating\Mono.TextTemplating.csproj" />
  </ItemGroup>

  <!-- Package build assets (.props, .targets, readme) -->
  <ItemGroup>
    <None Include="build\*.props" Pack="true" PackagePath="build\" />
    <None Include="build\*.targets" Pack="true" PackagePath="build\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Copy all DLLs and deps.json from output to tasks/ folder inside the NuGet package -->
  <Target Name="IncludeTaskDependencies" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_TaskOutputFiles Include="$(OutputPath)*.dll" />
      <_TaskOutputFiles Include="$(OutputPath)*.deps.json" />
    </ItemGroup>
    <ItemGroup>
      <_PackageFiles Include="@(_TaskOutputFiles)">
        <PackagePath>tasks\net10.0\%(Filename)%(Extension)</PackagePath>
      </_PackageFiles>
    </ItemGroup>
  </Target>

</Project>
