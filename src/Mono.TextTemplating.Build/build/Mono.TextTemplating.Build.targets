<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Mono.TextTemplating.Build.targets
    Post-build T4 pipeline — runs .tt files via the dotnet-t4 global tool.
    Install with: dotnet tool install -g Mono.TextTemplating.Cli
  -->

  <Target Name="TransformT4Templates"
          AfterTargets="Build"
          Condition="'@(T4PostBuildTemplate)' != ''">

    <Message Text="[T4] Transforming @(T4PostBuildTemplate->'%(Filename)','; ')"
             Importance="high" />

    <!-- Process each .tt individually via dotnet-t4 -->
    <Exec
      Command="dotnet t4 -o &quot;%(T4PostBuildTemplate.LastGenOutput)&quot; -r $(TargetPath) &quot;%(T4PostBuildTemplate.Identity)&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ContinueOnError="true"
      Condition="'%(T4PostBuildTemplate.Identity)' != ''" />

    <ItemGroup>
      <FileWrites Include="@(T4PostBuildTemplate->'%(LastGenOutput)')" />
      <Content Include="@(T4PostBuildTemplate->'%(LastGenOutput)')" Pack="false" />
    </ItemGroup>
  </Target>

  <Target Name="CleanT4Templates" AfterTargets="CoreClean">
    <Delete Files="@(T4PostBuildTemplate->'%(LastGenOutput)')" />
  </Target>

</Project>
