<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Mono.TextTemplating.Build.targets
    Post-build T4 pipeline: processes .tt files AFTER compilation,
    so templates can reflect on the built assembly.
  -->

  <UsingTask
    TaskName="Mono.TextTemplating.Build.TransformTemplates"
    AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\net10.0\Mono.TextTemplating.Build.dll" />

  <Target Name="TransformT4Templates"
          AfterTargets="Build"
          Condition="'@(T4PostBuildTemplate)' != ''"
          Inputs="@(T4PostBuildTemplate)"
          Outputs="@(T4PostBuildTemplate->'%(LastGenOutput)')">

    <Message Text="[T4] Transforming @(T4PostBuildTemplate->'%(Filename)','; ')" Importance="high" />

    <!-- Inject $(TargetPath) if the template item doesn't already have it -->
    <ItemGroup>
      <T4PostBuildTemplate>
        <T4Param_TargetAssembly Condition="'%(T4PostBuildTemplate.T4Param_TargetAssembly)' == ''">$(TargetPath)</T4Param_TargetAssembly>
      </T4PostBuildTemplate>
    </ItemGroup>

    <TransformTemplates
      Templates="@(T4PostBuildTemplate)"
      OutputDir="$(T4TemplateOutputDir)"
      References="@(ReferencePathWithRefAssemblies);$(TargetPath)"
      Preprocess="$(T4Preprocess)">

      <Output TaskParameter="GeneratedFiles" ItemName="T4GeneratedOutput" />
    </TransformTemplates>

    <ItemGroup>
      <FileWrites Include="@(T4GeneratedOutput)" />
      <Content Include="@(T4GeneratedOutput)" Pack="false" />
    </ItemGroup>
  </Target>

  <!-- Clean generated files -->
  <Target Name="CleanT4Templates" AfterTargets="CoreClean">
    <RemoveDir Directories="$(T4TemplateOutputDir)$(T4GeneratedDir)" Condition="Exists('$(T4TemplateOutputDir)')" />
    <Delete Files="@(T4PostBuildTemplate->'%(LastGenOutput)')" />
  </Target>

</Project>
