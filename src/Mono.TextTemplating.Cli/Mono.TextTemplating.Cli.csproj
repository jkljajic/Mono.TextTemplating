<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TextTransform</AssemblyName>
    <RootNamespace>Mono.TextTemplating</RootNamespace>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Title>TextTransform</Title>
    <Description>T4 text transformation CLI tool — processed .tt template files from the command line</Description>
    <Company>The Mono Project</Company>
    <Product>Mono.TextTemplating</Product>
    <Copyright>MIT</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Pack as a dotnet global tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-t4</ToolCommandName>
    <PackageId>Mono.TextTemplating.Cli</PackageId>
    <VersionPrefix>3.0.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <IsPackable>true</IsPackable>

    <AssemblyTitle>TextTransform — T4 CLI Tool</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mono.TextTemplating\Mono.TextTemplating.csproj" />
  </ItemGroup>

</Project>
