<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>T4Studio.Cli</AssemblyName>
    <RootNamespace>T4Studio</RootNamespace>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Title>T4 Studio CLI</Title>
    <Description>Command-line T4 text template transformer for T4 Studio.</Description>
    <Copyright>MIT</Copyright>
    <PackageTags>t4;text-templating;roslyn;code-generation;dotnet;templates;cli;tool</PackageTags>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>t4studio</ToolCommandName>
    <PackageId>T4Studio.Cli</PackageId>
    <IsPackable>true</IsPackable>

    <AssemblyTitle>T4 Studio CLI</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\T4Studio.Engine\T4Studio.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

